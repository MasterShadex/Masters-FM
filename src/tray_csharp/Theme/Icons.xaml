<!-- Stage 7.7B: System icon PathGeometry resources.
     All icons on a 24x24 viewbox. Use with:
         <Path Data="{StaticResource IconClose}"
               Fill="{StaticResource TextSecondary}"
               Width="16" Height="16" Stretch="Uniform"/>
     Sources: geometric approximations of Fluent UI System Icons
              (Apache 2.0 licensed) on 24x24 grid.
     Complex icons (Info, Warning, Error, Settings, Camera) use
     GeometryGroup with EvenOdd fill rule for negative-space details. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Close / Dismiss: X mark -->
    <PathGeometry x:Key="IconClose"
        Figures="M12 10.586 L5.707 4.293 L4.293 5.707 L10.586 12 L4.293 18.293 L5.707 19.707 L12 13.414 L18.293 19.707 L19.707 18.293 L13.414 12 L19.707 5.707 L18.293 4.293 Z"/>

    <!-- Minimize: horizontal bar -->
    <PathGeometry x:Key="IconMinimize"
        Figures="M4 11.5 L20 11.5 L20 12.5 L4 12.5 Z"/>

    <!-- Chevron Right: > pointing right -->
    <PathGeometry x:Key="IconChevronRight"
        Figures="M8.59 16.59 L13.17 12 L8.59 7.41 L10 6 L16 12 L10 18 Z"/>

    <!-- Chevron Down: v pointing down -->
    <PathGeometry x:Key="IconChevronDown"
        Figures="M7.41 8.59 L12 13.17 L16.59 8.59 L18 10 L12 16 L6 10 Z"/>

    <!-- Check: checkmark -->
    <PathGeometry x:Key="IconCheck"
        Figures="M9 16.17 L4.83 12 L3.41 13.41 L9 19 L21 7 L19.59 5.59 Z"/>

    <!-- Arrow Left: leftward arrow with shaft -->
    <PathGeometry x:Key="IconArrowLeft"
        Figures="M20 11 L7.83 11 L13.42 5.41 L12 4 L4 12 L12 20 L13.41 18.59 L7.83 13 L20 13 Z"/>

    <!-- Arrow Right: rightward arrow with shaft -->
    <PathGeometry x:Key="IconArrowRight"
        Figures="M4 11 L16.17 11 L10.59 5.41 L12 4 L20 12 L12 20 L10.59 18.59 L16.17 13 L4 13 Z"/>

    <!-- Reset / Refresh: circular arrow arc with arrowhead -->
    <PathGeometry x:Key="IconReset"
        Figures="M4 12 A8 8 0 0 0 19.07 15.07 L17.5 14 A6 6 0 0 1 6 12 A6 6 0 0 1 14.83 6.17 L12 4 L17 4 L17 9 L14.17 6.17 A8 8 0 0 0 4 12 Z"/>

    <!-- Speaker: cone + body shape -->
    <PathGeometry x:Key="IconSpeaker"
        Figures="M3 9 L7 9 L13 4 L13 20 L7 15 L3 15 Z M15.5 8.5 A5 5 0 0 1 15.5 15.5 L14.3 14.3 A3.5 3.5 0 0 0 14.3 9.7 Z"/>

    <!-- Mic: capsule + base arc + stand -->
    <PathGeometry x:Key="IconMic"
        Figures="M8 12 A4 4 0 0 0 16 12 L16 7 A4 4 0 0 0 8 7 Z M6 12 A6 6 0 0 0 18 12 L17 12 A5 5 0 0 1 7 12 Z M11 18 L11 22 L13 22 L13 18 Z M8 22 L16 22 L16 21 L8 21 Z"/>

    <!-- Info: filled circle with i-mark (dot + stem) as negative space -->
    <GeometryGroup x:Key="IconInfo" FillRule="EvenOdd">
        <EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10"/>
        <RectangleGeometry Rect="11,7,2,2"/>
        <RectangleGeometry Rect="11,11,2,6"/>
    </GeometryGroup>

    <!-- Warning: filled triangle with ! mark (stem + dot) as negative space -->
    <GeometryGroup x:Key="IconWarning" FillRule="EvenOdd">
        <PathGeometry Figures="M12 3 L22 20 L2 20 Z"/>
        <RectangleGeometry Rect="11,10,2,5"/>
        <RectangleGeometry Rect="11,16.5,2,1.5"/>
    </GeometryGroup>

    <!-- Error: filled circle with X mark as negative space -->
    <GeometryGroup x:Key="IconError" FillRule="EvenOdd">
        <EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10"/>
        <PathGeometry Figures="M12 10.586 L7.621 6.207 L6.207 7.621 L10.586 12 L6.207 16.379 L7.621 17.793 L12 13.414 L16.379 17.793 L17.793 16.379 L13.414 12 L17.793 7.621 L16.379 6.207 Z"/>
    </GeometryGroup>

    <!-- Settings / Gear: outer ring with center hole -->
    <GeometryGroup x:Key="IconSettings" FillRule="EvenOdd">
        <PathGeometry Figures="M13.5 3 L10.5 3 L9.29 5.29 L7 4.31 L5 6.31 L5.98 8.6 L3.69 9.81 L3.69 12.81 L5.97 14.02 L5 16.31 L7 18.31 L9.28 17.33 L10.5 19.63 L13.5 19.63 L14.72 17.33 L17 18.31 L19 16.31 L18.02 14.02 L20.31 12.81 L20.31 9.81 L18.02 8.6 L19 6.31 L17 4.31 L14.71 5.29 Z"/>
        <EllipseGeometry Center="12,11.5" RadiusX="3.5" RadiusY="3.5"/>
    </GeometryGroup>

    <!-- Camera (OBS): camera body with lens aperture -->
    <GeometryGroup x:Key="IconCamera" FillRule="EvenOdd">
        <PathGeometry Figures="M20 5 L16 5 L14 3 L10 3 L8 5 L4 5 C3 5 2 6 2 7 L2 19 C2 20 3 21 4 21 L20 21 C21 21 22 20 22 19 L22 7 C22 6 21 5 20 5 Z"/>
        <EllipseGeometry Center="12,13" RadiusX="4" RadiusY="4"/>
    </GeometryGroup>

    <!-- Sparkle: 4-pointed star with elongated vertical/horizontal points.
         Used for "Customize" feature bullet in WelcomeWindow. -->
    <PathGeometry x:Key="IconSparkle"
        Figures="M12 2 L13.2 10.8 L22 12 L13.2 13.2 L12 22 L10.8 13.2 L2 12 L10.8 10.8 Z"/>

    <!-- Stage 7.12 Batch A STEP 6: 4 additional icons for previously icon-less menu items -->

    <!-- Discord: chat bubble with bottom-left tail (chat app symbol) -->
    <PathGeometry x:Key="IconDiscord"
        Figures="M4 4 L20 4 A2 2 0 0 1 22 6 L22 15 A2 2 0 0 1 20 17 L12 17 L8 21 L8 17 L4 17 A2 2 0 0 1 2 15 L2 6 A2 2 0 0 1 4 4 Z"/>

    <!-- Startup / Power: vertical stem + C-shaped arc (universal power-on symbol) -->
    <PathGeometry x:Key="IconStartup"
        Figures="M11 3 L13 3 L13 12 L11 12 Z M7.05 5.05 L8.46 6.46 A6 6 0 1 0 15.54 6.46 L16.95 5.05 A8 8 0 1 1 7.05 5.05 Z"/>

    <!-- Document / Log: page with folded top-right corner and 3 horizontal text lines -->
    <GeometryGroup x:Key="IconDocument" FillRule="EvenOdd">
        <PathGeometry Figures="M6 2 L14 2 L19 7 L19 22 L6 22 Z"/>
        <PathGeometry Figures="M14 2 L14 7 L19 7 Z"/>
        <RectangleGeometry Rect="8,11,9,1.2"/>
        <RectangleGeometry Rect="8,14,9,1.2"/>
        <RectangleGeometry Rect="8,17,6,1.2"/>
    </GeometryGroup>

    <!-- Restart: clockwise circular arrow (mirror of IconReset) — distinct from
         IconReset on "Check for updates" so the two items don't look identical. -->
    <PathGeometry x:Key="IconRestart"
        Figures="M20 12 A8 8 0 0 1 4.93 15.07 L6.5 14 A6 6 0 0 0 18 12 A6 6 0 0 0 9.17 6.17 L12 4 L7 4 L7 9 L9.83 6.17 A8 8 0 0 1 20 12 Z"/>

</ResourceDictionary>
