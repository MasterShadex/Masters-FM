<!-- Stage 7.7B STEP 5: Context-menu styles.
     Three styles: AppContextMenuStyle (popup shell), AppMenuItemStyle (row),
     AppMenuSeparatorStyle (divider line).
     Depends on: Colors.xaml (Surface1, Surface2, BorderSubtle, TextPrimary,
                              BrandPurpleBase, CardHoverShadow),
                 Icons.xaml (IconCheck).
     Class K fix: all cross-file resource refs inside ControlTemplate content
     use DynamicResource (not StaticResource). WPF DeferredResourceReference
     in ControlTemplate resolves against the owning ResourceDictionary scope
     only; DynamicResource defers to element-bind time when Application.Resources
     is fully accessible. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === ContextMenu shell (Stage 7.23 refresh) ===
         Solid TrayMenuBackgroundBrush (#1A1A1A) bg, crisp 1px TrayMenuBorderBrush
         (#33FFFFFF, 20% white) border, 10px radius (was 8 in Stage 7.22 ; bumped
         per S0.6 token), TrayMenuDropShadow (BlurRadius 20, ShadowDepth 4,
         Opacity 0.5 ; more pronounced than CardHoverShadow). Inner padding 4
         (was 6) gives the item-internal rounded backgrounds a tight fit inside
         the new larger container corner radius without item edges visibly
         intersecting the container border.
         MinWidth 240 (unchanged) still accommodates the new 18px icons. -->
    <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background"      Value="{DynamicResource TrayMenuBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource TrayMenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="4"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="MinWidth"        Value="240"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource TrayMenuContainerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource TrayMenuDropShadow}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === MenuItem row (Stage 7.23 ROUND 2 refresh) ===
         High-contrast + readability pass:
           * Auto-height (Border Padding 14,10 drives vertical space; Grid no
             longer has a fixed 36px Height because two-line items need to grow)
           * 5-column layout : 18px icon : 10px gap : * label-stack : 8px gap : 18px check
           * Pure white label foreground (TrayMenuTextPrimaryBrush #FFFFFF)
           * 16px FontSize (was 13) for primary label
           * Inline description support via MenuItem.Tag property : if Tag is set,
             a 12px secondary TextBlock renders below the primary label using
             TrayMenuTextSecondaryBrush (#B0B0B0). Items without Tag have null
             Tag by default; the Tag={x:Null} trigger collapses the description
             TextBlock so single-line items render exactly as before.
           * IsHighlighted : NEUTRAL white tint (TrayMenuHoverBrush #22FFFFFF;
             was 10% accent in Stage 7.22)
           * IsPressed    : stronger neutral tint (TrayMenuPressedBrush #33FFFFFF)
           * IsChecked    : Win11-style accent checkmark Path (unchanged from 7.22)
             stroked with TrayMenuAccentBrush (#7C3AED) for toggle-ON state
           * IsEnabled=False : 45% opacity, arrow cursor (unchanged) -->
    <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground"  Value="{DynamicResource TrayMenuTextPrimaryBrush}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="{DynamicResource TrayMenuItemFontSize}"/>
        <Setter Property="Padding"     Value="{DynamicResource TrayMenuItemPadding}"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{DynamicResource TrayMenuItemRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon column : displays MenuItem.Icon content (Path
                                 Width/Height 18 set per-item in MainWindow.xaml).
                                 Items without an icon leave this slot empty (the
                                 18px column stays reserved so labels still align). -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>

                            <!-- Label column : StackPanel of primary Header line
                                 plus optional secondary description TextBlock.
                                 The description binds to MenuItem.Tag; when Tag
                                 is null (default for items without Tag set), the
                                 ControlTemplate.Triggers Tag={x:Null} rule
                                 collapses the description so single-line items
                                 occupy only the height needed for the primary line. -->
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                <ContentPresenter x:Name="HeaderContent"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"/>
                                <TextBlock x:Name="DescriptionLine"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="{DynamicResource TrayMenuDescriptionFontSize}"
                                           Foreground="{DynamicResource TrayMenuTextSecondaryBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Check column (Stage 7.22 carry-over) : Win11-style
                                 accent checkmark. Path "M 0 7 L 5 12 L 14 0" draws
                                 the canonical Win11 check stroke (short leg, long
                                 leg). Stroke is TrayMenuAccentBrush (#7C3AED;
                                 local alias for BrandPurpleDeep). Collapsed by
                                 default; Visible when IsChecked=True. Width/Height
                                 14x12 inside the 18px column gives 2px of breathing
                                 room on each side. -->
                            <Path x:Name="CheckMark"
                                  Grid.Column="4"
                                  Data="M 0 7 L 5 12 L 14 0"
                                  Stroke="{DynamicResource TrayMenuAccentBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="14" Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Tag=null hides the description line. Default state
                             for items without Tag set in MainWindow.xaml. -->
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="DescriptionLine" Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource TrayMenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource TrayMenuPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Sub-header MenuItem (Stage 7.23) ===
         Non-interactive wrapper that renders a small uppercase ACTIONS / TOGGLES /
         ABOUT label between menu sections. Implemented as a MenuItem wrapper
         (rather than a bare TextBlock sibling) so it lives cleanly inside the
         ContextMenu's items panel without WPF complaining about non-MenuItem
         children. IsHitTestVisible=False + Focusable=False keep it from
         consuming hover or keyboard focus so the menu navigation still flows
         smoothly through the actionable items. The ControlTemplate replaces the
         entire row with a single TextBlock styled per the Stage 7.23 tokens. -->
    <Style x:Key="AppMenuSubHeaderStyle" TargetType="MenuItem">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable"        Value="False"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Cursor"           Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <TextBlock Text="{TemplateBinding Header}"
                               FontFamily="Segoe UI"
                               FontSize="{DynamicResource TrayMenuSubHeaderFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TrayMenuTextTertiaryBrush}"
                               Padding="{DynamicResource TrayMenuSubHeaderPadding}"
                               TextOptions.TextRenderingMode="ClearType"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Header MenuItem variant ===
         Same look as AppMenuItemStyle (Foreground, FontFamily, hover bg, etc.)
         but the template uses an AUTO-height ContentPresenter instead of the
         fixed 36-px Grid.  Lets the tray header show two lines (Master's FM
         wordmark + now-playing track) without the second line being clipped
         by the row height.  No icon/check columns; header content spans
         the full width via its own negative margins. -->
    <Style x:Key="AppMenuHeaderStyle" TargetType="MenuItem"
           BasedOn="{StaticResource AppMenuItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center"
                                          Margin="0,6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Separator (Stage 7.23 refresh) ===
         1px low-contrast horizontal rule. Stage 7.22 introduced
         TrayMenuSeparatorBrush over BorderSubtle for a translucent feel;
         Stage 7.23 dials the visual weight down further now that sub-headers
         (ACTIONS / TOGGLES / ABOUT) carry the primary visual grouping.
         Side inset bumped 12 -> 14 to match the new 14,10 MenuItem padding.
         Vertical inset bumped 4 -> 6 for more breathing room around grouped
         items. Added Opacity 0.6 so the line reads as a hint rather than a
         hard rule. -->
    <Style x:Key="AppMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Margin="{DynamicResource TrayMenuSeparatorMargin}"
                            Height="1"
                            Opacity="0.6"
                            Background="{DynamicResource TrayMenuSeparatorBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
