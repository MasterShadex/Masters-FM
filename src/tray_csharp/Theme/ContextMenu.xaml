<!-- Stage 7.7B STEP 5: Context-menu styles.
     Three styles: AppContextMenuStyle (popup shell), AppMenuItemStyle (row),
     AppMenuSeparatorStyle (divider line).
     Depends on: Colors.xaml (Surface1, Surface2, BorderSubtle, TextPrimary,
                              BrandPurpleBase, CardHoverShadow),
                 Icons.xaml (IconCheck).
     Class K fix: all cross-file resource refs inside ControlTemplate content
     use DynamicResource (not StaticResource). WPF DeferredResourceReference
     in ControlTemplate resolves against the owning ResourceDictionary scope
     only; DynamicResource defers to element-bind time when Application.Resources
     is fully accessible. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === ContextMenu shell (Stage 7.22 refresh) ===
         Surface1 background, 1px BorderSubtle, 8px radius (was 12 - tighter Win11
         feel), CardHoverShadow. Inner padding 6 (was 4) gives the rounded items
         a bit more room to breathe inside the container corners.
         MinWidth 240 (was 220) accommodates the slightly wider 16px icons.
         On Win11 22H2+ the code-behind overrides Background to Transparent
         and applies Acrylic; the CornerRadius stays in effect regardless. -->
    <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background"      Value="{DynamicResource Surface1}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="MinWidth"        Value="240"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource CardHoverShadow}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === MenuItem row (Stage 7.22 refresh) ===
         Win11-style modern feel:
           * 36px tall; 3-column layout: 16px icon | 8px gap | * label | 8px gap | 16px check
           * Padding 12,8 for breathing room on left/right edges
           * IsHighlighted : translucent accent tint (TrayMenuHoverBrush ~10%)
           * IsPressed    : slightly stronger tint (TrayMenuPressedBrush ~20%)
           * IsChecked    : Win11-style checkmark Path (M 0 7 L 5 12 L 14 0)
                             filled with BrandPurpleDeep (#7C3AED accent)
           * IsEnabled=False : 45% opacity, arrow cursor
         Icon column: renders MenuItem.Icon content (set per-item in XAML).
         Check column: inline Path with the Win11 checkmark stroke geometry;
         hidden by default, shown when IsChecked=True (Discord, AutoStart, OBS). -->
    <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="12,0"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Grid Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon column: displays MenuItem.Icon content.
                                 Items without an icon leave this slot empty (the
                                 16px column stays reserved so labels still align). -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>

                            <!-- Label column: the Header string or custom Header object. -->
                            <ContentPresenter x:Name="HeaderContent"
                                              Grid.Column="2"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>

                            <!-- Check column (Stage 7.22): Win11-style accent checkmark.
                                 Path "M 0 7 L 5 12 L 14 0" draws the canonical Win11
                                 check stroke (short leg, long leg). Fill is BrandPurpleDeep
                                 (operator's locked accent hex #7C3AED). Collapsed by
                                 default; Visible when IsChecked=True. StrokeThickness
                                 not needed since the Fill is solid; the geometry is
                                 closed by Stretch=Uniform stretching to the 12x12 cell. -->
                            <Path x:Name="CheckMark"
                                  Grid.Column="4"
                                  Data="M 0 7 L 5 12 L 14 0"
                                  Stroke="{DynamicResource BrandPurpleDeep}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="14" Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource TrayMenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource TrayMenuPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Header MenuItem variant ===
         Same look as AppMenuItemStyle (Foreground, FontFamily, hover bg, etc.)
         but the template uses an AUTO-height ContentPresenter instead of the
         fixed 36-px Grid.  Lets the tray header show two lines (Master's FM
         wordmark + now-playing track) without the second line being clipped
         by the row height.  No icon/check columns — header content spans
         the full width via its own negative margins. -->
    <Style x:Key="AppMenuHeaderStyle" TargetType="MenuItem"
           BasedOn="{StaticResource AppMenuItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center"
                                          Margin="0,6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Separator (Stage 7.22 refresh) ===
         1px low-contrast horizontal rule. Switched from opaque BorderSubtle to
         the new TrayMenuSeparatorBrush (50% translucent white) for a subtler
         Win11-style divider that reads well over both Surface1 (Win10 branch)
         and Acrylic backdrop (Win11 branch). Side inset bumped 8 -> 12 to
         match the new 12,0 MenuItem padding so separators line up visually
         with item label edges. -->
    <Style x:Key="AppMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Margin="12,4"
                            Height="1"
                            Background="{DynamicResource TrayMenuSeparatorBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
