<!-- Stage 7.7B: Shared Window chrome — AppDialogStyle.
     WindowStyle=None, AllowsTransparency=True, custom chrome.
     Top: 3px accent bar (AccentBarGradient) with shimmer storyboard.
     Title bar: 44px; PART_TitleBar drag region, PART_CloseButton (X),
     PART_MinimizeButton (Collapsed by default).
     Content: AdornerDecorator wrapping ContentPresenter.
     Template parts (wired per-dialog in OnApplyTemplate):
       PART_TitleBar        — MouseLeftButtonDown to call DragMove()
       PART_CloseButton     — Click to call Close()
       PART_MinimizeButton  — Click to set WindowState=Minimized
     Depends on: Colors.xaml (AccentBarGradient, Surface1, TextPrimary,
                              TextSecondary, DialogShadow),
                 Typography.xaml (SubHeadingTextStyle),
                 Buttons.xaml (IconButtonStyle),
                 Icons.xaml (IconClose, IconMinimize).
     Note: AccentBarDuration is defined locally in ControlTemplate.Resources
     (not from Animations.xaml) due to WPF StaticResource scoping rules. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AppDialogStyle" TargetType="Window">
        <!-- Chrome properties: no OS frame, transparent host for shadow bleed. -->
        <Setter Property="WindowStyle"           Value="None"/>
        <Setter Property="AllowsTransparency"    Value="True"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="ResizeMode"            Value="NoResize"/>
        <Setter Property="ShowInTaskbar"         Value="True"/>
        <Setter Property="Foreground"            Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily"            Value="Segoe UI"/>
        <Setter Property="FontSize"              Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <!-- ControlTemplate.Resources intentionally empty.
                         AccentBarDuration and AccentBarShimmer were moved out of here;
                         the Storyboard is now inlined in the EventTrigger below (see
                         ControlTemplate.Triggers). Reason: a Storyboard stored in
                         ControlTemplate.Resources is frozen/shared across template
                         instances; the frozen Storyboard cannot resolve
                         Storyboard.TargetName across multiple dialogs and throws
                         InvalidOperationException 'AccentShimmer name cannot be found
                         in the name scope of ControlTemplate'. Inlining the Storyboard
                         directly in BeginStoryboard keeps it per-instance, allowing
                         correct name-scope resolution for every dialog window. -->

                    <!-- Shadow bleed margin: 12px on all sides so the drop
                         shadow is not clipped by the window bounds. -->
                    <Grid Margin="12">
                        <!-- Outer layer provides the drop shadow. -->
                        <Border Effect="{DynamicResource DialogShadow}"
                                CornerRadius="12"
                                Background="{DynamicResource Surface1}">
                            <DockPanel LastChildFill="True">

                                <!-- === 3px accent bar (top) === -->
                                <Grid DockPanel.Dock="Top" Height="3">
                                    <!-- Brand gradient fill. -->
                                    <Border x:Name="AccentBar"
                                            Background="{DynamicResource AccentBarGradient}"/>
                                    <!-- Shimmer overlay: white highlight, animated opacity. -->
                                    <Border x:Name="AccentShimmer"
                                            Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0.00" Color="Transparent"/>
                                                <GradientStop Offset="0.40" Color="Transparent"/>
                                                <GradientStop Offset="0.50" Color="#55FFFFFF"/>
                                                <GradientStop Offset="0.60" Color="Transparent"/>
                                                <GradientStop Offset="1.00" Color="Transparent"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <!-- === 44px title bar === -->
                                <Grid DockPanel.Dock="Top" Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PART_TitleBar: transparent drag region spanning the
                                         full title bar. The dialog's OnApplyTemplate wires
                                         MouseLeftButtonDown to call DragMove(). -->
                                    <Border x:Name="PART_TitleBar"
                                            Grid.ColumnSpan="3"
                                            Background="Transparent"/>

                                    <!-- Dialog title: not hit-testable so drag still works. -->
                                    <TextBlock Grid.Column="0"
                                               Text="{TemplateBinding Title}"
                                               Style="{DynamicResource SubHeadingTextStyle}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"
                                               IsHitTestVisible="False"/>

                                    <!-- PART_MinimizeButton: hidden by default; dialogs that
                                         need it set Visibility=Visible in OnApplyTemplate. -->
                                    <Button x:Name="PART_MinimizeButton"
                                            Grid.Column="1"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Visibility="Collapsed"
                                            Margin="0,6,4,6">
                                        <Path Data="{DynamicResource IconMinimize}"
                                              Fill="{DynamicResource TextSecondary}"
                                              Width="12" Height="2"
                                              Stretch="Fill"/>
                                    </Button>

                                    <!-- PART_CloseButton: wired by OnApplyTemplate to Close(). -->
                                    <Button x:Name="PART_CloseButton"
                                            Grid.Column="2"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Margin="0,6,8,6">
                                        <Path Data="{DynamicResource IconClose}"
                                              Fill="{DynamicResource TextSecondary}"
                                              Width="10" Height="10"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- === Content area === -->
                                <!-- AdornerDecorator is required so that adorner-layer
                                     elements (tooltips, validation highlights, popups)
                                     render correctly inside a Window with a custom
                                     ControlTemplate. -->
                                <AdornerDecorator>
                                    <ContentPresenter/>
                                </AdornerDecorator>

                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Stage 7.7B-FIX: AccentBar shimmer animation deferred to code-behind.
                         WPF ControlTemplate.Triggers EventTrigger + Storyboard.TargetName
                         cannot reliably resolve named template elements (AccentShimmer) at
                         trigger-fire time when the template is shared across multiple
                         Window instances; the name scope lookup throws
                         InvalidOperationException. Animation is started in OnApplyTemplate
                         (per-dialog code-behind) once the template is applied and the named
                         parts are accessible via GetTemplateChild. -->
                    <ControlTemplate.Triggers/>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
