<!-- Stage 7.7B: Shared Window chrome — AppDialogStyle.
     WindowStyle=None, AllowsTransparency=True, custom chrome.
     Top: 3px accent bar (AccentBarGradient) with shimmer storyboard.
     Title bar: 44px; PART_TitleBar drag region, PART_CloseButton (X),
     PART_MinimizeButton (Collapsed by default).
     Content: AdornerDecorator wrapping ContentPresenter.
     Template parts (wired per-dialog in OnApplyTemplate):
       PART_TitleBar        — MouseLeftButtonDown to call DragMove()
       PART_CloseButton     — Click to call Close()
       PART_MinimizeButton  — Click to set WindowState=Minimized
     Depends on: Colors.xaml (AccentBarGradient, Surface1, TextPrimary,
                              TextSecondary, DialogShadow),
                 Typography.xaml (SubHeadingTextStyle),
                 Buttons.xaml (IconButtonStyle),
                 Icons.xaml (IconClose, IconMinimize).
     Note: AccentBarDuration is defined locally in ControlTemplate.Resources
     (not from Animations.xaml) due to WPF StaticResource scoping rules. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AppDialogStyle" TargetType="Window">
        <!-- Chrome properties: no OS frame, transparent host for shadow bleed. -->
        <Setter Property="WindowStyle"           Value="None"/>
        <Setter Property="AllowsTransparency"    Value="True"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="ResizeMode"            Value="NoResize"/>
        <Setter Property="ShowInTaskbar"         Value="True"/>
        <Setter Property="Foreground"            Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily"            Value="Segoe UI"/>
        <Setter Property="FontSize"              Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <ControlTemplate.Resources>
                        <!-- AccentBarDuration must be defined here because {StaticResource}
                             inside ControlTemplate.Resources cannot traverse sibling merged
                             dictionaries (Animations.xaml). WPF StaticResource scoping:
                             lookup is local-dict-first, then logical tree; it does NOT
                             search the parent ResourceDictionary's MergedDictionaries.
                             Value matches the Animations.xaml definition (8 seconds). -->
                        <Duration x:Key="AccentBarDuration">0:0:8</Duration>

                        <!-- AccentBarShimmer: opacity pulse on the white highlight overlay.
                             AutoReverse gives a smooth in-out sweep without a jump cut.
                             Reduced-motion: dialogs that need it stop this storyboard in
                             OnApplyTemplate when app-level reduced-motion is active. -->
                        <Storyboard x:Key="AccentBarShimmer"
                                    RepeatBehavior="Forever"
                                    AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="AccentShimmer"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.0" To="0.55"
                                             Duration="{StaticResource AccentBarDuration}"/>
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <!-- Shadow bleed margin: 12px on all sides so the drop
                         shadow is not clipped by the window bounds. -->
                    <Grid Margin="12">
                        <!-- Outer layer provides the drop shadow. -->
                        <Border Effect="{StaticResource DialogShadow}"
                                CornerRadius="12"
                                Background="{StaticResource Surface1}">
                            <DockPanel LastChildFill="True">

                                <!-- === 3px accent bar (top) === -->
                                <Grid DockPanel.Dock="Top" Height="3">
                                    <!-- Brand gradient fill. -->
                                    <Border x:Name="AccentBar"
                                            Background="{StaticResource AccentBarGradient}"/>
                                    <!-- Shimmer overlay: white highlight, animated opacity. -->
                                    <Border x:Name="AccentShimmer"
                                            Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0.00" Color="Transparent"/>
                                                <GradientStop Offset="0.40" Color="Transparent"/>
                                                <GradientStop Offset="0.50" Color="#55FFFFFF"/>
                                                <GradientStop Offset="0.60" Color="Transparent"/>
                                                <GradientStop Offset="1.00" Color="Transparent"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <!-- === 44px title bar === -->
                                <Grid DockPanel.Dock="Top" Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PART_TitleBar: transparent drag region spanning the
                                         full title bar. The dialog's OnApplyTemplate wires
                                         MouseLeftButtonDown to call DragMove(). -->
                                    <Border x:Name="PART_TitleBar"
                                            Grid.ColumnSpan="3"
                                            Background="Transparent"/>

                                    <!-- Dialog title: not hit-testable so drag still works. -->
                                    <TextBlock Grid.Column="0"
                                               Text="{TemplateBinding Title}"
                                               Style="{StaticResource SubHeadingTextStyle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"
                                               IsHitTestVisible="False"/>

                                    <!-- PART_MinimizeButton: hidden by default; dialogs that
                                         need it set Visibility=Visible in OnApplyTemplate. -->
                                    <Button x:Name="PART_MinimizeButton"
                                            Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            Visibility="Collapsed"
                                            Margin="0,6,4,6">
                                        <Path Data="{StaticResource IconMinimize}"
                                              Fill="{StaticResource TextSecondary}"
                                              Width="12" Height="2"
                                              Stretch="Fill"/>
                                    </Button>

                                    <!-- PART_CloseButton: wired by OnApplyTemplate to Close(). -->
                                    <Button x:Name="PART_CloseButton"
                                            Grid.Column="2"
                                            Style="{StaticResource IconButtonStyle}"
                                            Margin="0,6,8,6">
                                        <Path Data="{StaticResource IconClose}"
                                              Fill="{StaticResource TextSecondary}"
                                              Width="10" Height="10"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- === Content area === -->
                                <!-- AdornerDecorator is required so that adorner-layer
                                     elements (tooltips, validation highlights, popups)
                                     render correctly inside a Window with a custom
                                     ControlTemplate. -->
                                <AdornerDecorator>
                                    <ContentPresenter/>
                                </AdornerDecorator>

                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Start shimmer on load. Duration is fixed at template apply
                         time; dialogs needing reduced-motion must stop this storyboard
                         programmatically in OnApplyTemplate. -->
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource AccentBarShimmer}"/>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
