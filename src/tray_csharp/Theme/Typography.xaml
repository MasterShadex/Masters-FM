<!-- Stage 7.7B: Typography scale.
     All styles target TextBlock. FontFamily: "Segoe UI" (Windows-native).
     Note: WPF has no native letter-spacing property; tracking is omitted.
     The Tiny style uses TextDecorations for uppercase character simulation;
     actual uppercase is achieved via CharacterCasing on TextBox or explicit
     content at each usage site. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Display: 28px SemiBold. Used for Welcome hero, dialog titles. -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="Segoe UI"/>
        <Setter Property="FontSize"      Value="28"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- Heading: 18px SemiBold. Used for section headers. -->
    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- SubHeading: 15px SemiBold. Used for tab labels, list group titles. -->
    <Style x:Key="SubHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- BodyStrong: 14px SemiBold. Used for button labels, important inline. -->
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Body: 14px Normal, 1.5 line-height (21px at 14px font). -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="Segoe UI"/>
        <Setter Property="FontSize"            Value="14"/>
        <Setter Property="FontWeight"          Value="Normal"/>
        <Setter Property="LineHeight"          Value="21"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Caption: 12px Normal, 1.45 line-height (~17px). Used for helper text, labels. -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="Segoe UI"/>
        <Setter Property="FontSize"            Value="12"/>
        <Setter Property="FontWeight"          Value="Normal"/>
        <Setter Property="LineHeight"          Value="17"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Tiny: 11px Medium UPPERCASE. Used for metadata, badges.
         Uppercase applied at usage site (no native WPF letter-spacing). -->
    <Style x:Key="TinyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Mono: Cascadia Mono 13px. Used for device IDs, paths. -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

</ResourceDictionary>
