<!-- Stage 7.7B: Brand icon PathGeometry resources.
     Monochrome paths for SoundCloud, Spotify, YouTube Music, Apple Music,
     VLC, Tidal. Tint to BrandPurpleGlow at 0.85 opacity at each usage
     site, NOT in these resources (no color hardcoded here).
     Paths are simplified geometric approximations of each brand's
     official mark on a 24x24 viewbox.
     Usage:
         <Path Data="{StaticResource BrandIconSpotify}"
               Fill="{StaticResource BrandPurpleGlow}"
               Opacity="0.85"
               Width="20" Height="20" Stretch="Uniform"/> -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spotify: three wavy horizontal arcs (the classic radial-wave mark) -->
    <PathGeometry x:Key="BrandIconSpotify"
        Figures="M6 9 C8.5 8 11 8 14 9 C17 10 19.5 10 22 9 L22 10.5 C19.5 11.5 17 11.5 14 10.5 C11 9.5 8.5 9.5 6 10.5 Z M6 13 C8.5 12 11.5 12 14 13 C16.5 14 18.5 14 21 13 L21 14.5 C18.5 15.5 16.5 15.5 14 14.5 C11.5 13.5 8.5 13.5 6 14.5 Z M6 17 C8 16 10.5 16 13 17 C15.5 18 17.5 18 20 17 L20 18.5 C17.5 19.5 15.5 19.5 13 18.5 C10.5 17.5 8 17.5 6 18.5 Z"/>

    <!-- SoundCloud: cloud silhouette (horizontal extended cloud) -->
    <PathGeometry x:Key="BrandIconSoundCloud"
        Figures="M2 16 A4 4 0 0 1 5 8.27 C5.59 5.84 7.82 4 10.5 4 A7 7 0 0 1 17.46 9 L18 9 A4 4 0 0 1 18 17 Z"/>

    <!-- YouTube Music: play triangle inside rounded square -->
    <GeometryGroup x:Key="BrandIconYouTubeMusic" FillRule="EvenOdd">
        <PathGeometry Figures="M2 6 C2 3.79 3.79 2 6 2 L18 2 C20.21 2 22 3.79 22 6 L22 18 C22 20.21 20.21 22 18 22 L6 22 C3.79 22 2 20.21 2 18 Z"/>
        <PathGeometry Figures="M10 8 L10 16 L17 12 Z"/>
    </GeometryGroup>

    <!-- Apple Music: musical note (quarter note with filled head + stem + flag) -->
    <PathGeometry x:Key="BrandIconAppleMusic"
        Figures="M9 16 A3 3 0 1 0 9 16.01 L9 8 L18 6 L18 14 A3 3 0 1 0 18 14.01 Z"/>

    <!-- VLC: stylized traffic cone (triangle) -->
    <PathGeometry x:Key="BrandIconVLC"
        Figures="M12 3 L22 21 L2 21 Z M8 17 L16 17 L16 19 L8 19 Z"/>

    <!-- Tidal: wave-like chevron pair (stylized T shape) -->
    <PathGeometry x:Key="BrandIconTidal"
        Figures="M2 8 L8 8 L12 14 L16 8 L22 8 L12 20 Z M8 3 L12 9 L16 3 Z"/>

</ResourceDictionary>
