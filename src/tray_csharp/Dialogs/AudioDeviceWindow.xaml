<!-- Stage 7.7B: STEP 4 AudioDeviceWindow visual rebuild.
     Design system tokens throughout. AppDialogStyle chrome.
     Custom tab bar: WASAPI / MME / KS / ASIO, 2px brand-purple indicator.
     List rows: 56px, 3px left accent on selected item. No Apply/Cancel;
     auto-persist via SelectedDevice binding. Reset = CancelCommand (reverts
     to original-on-open value). Device enumeration unchanged (S4.5). -->
<Window x:Class="MastersFM.Tray.Dialogs.AudioDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Source"
        Width="640" Height="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppDialogStyle}">

    <Window.Resources>
        <!-- Custom tab item: text label + 2px brand-purple bottom indicator.
             Indicator appears instantly on IsSelected (no storyboard for
             the indicator itself; full animated slide is deferred). -->
        <Style x:Key="AudioTabItemStyle" TargetType="TabItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Margin"      Value="0,0,24,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <!-- Stage 7.12 Issue 3-A: MinWidth prevents TabPanel from shrinking
                 tabs below the width needed to display the label fully.
                 120px accommodates "WASAPI" at Segoe UI 15px SemiBold at high DPI. -->
            <Setter Property="MinWidth"    Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="44" VerticalAlignment="Stretch">
                            <!-- Tab label: HorizontalAlignment=Center so short
                                 labels (MME, KS, ASIO) sit centred within their
                                 MinWidth slot rather than clipping to the left. -->
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Header}"
                                       Style="{StaticResource SubHeadingTextStyle}"
                                       Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <!-- Selected indicator: 2px bottom border, width = label text width,
                                 centered so the line sits under the text, not across the full slot. -->
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Width="{Binding ElementName=Label, Path=ActualWidth}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource BrandPurpleBase}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label"     Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl template: removes the WPF chrome border; tabs sit
             flush against the bottom separator line. -->
        <Style x:Key="AudioTabControlStyle" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Tab header row -->
                                <RowDefinition Height="Auto"/>
                                <!-- 1px separator -->
                                <RowDefinition Height="1"/>
                                <!-- Content area -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab strip (ItemsPresenter renders the TabItems).
                                 Margin="24,0,0,0" aligns tab labels with the
                                 header Border Padding="24,0" above. -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        IsItemsHost="False"
                                        Margin="24,0,0,0">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"/>
                            </StackPanel>
                            <!-- Separator -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource BorderSubtle}"/>
                            <!-- Tab content -->
                            <Border Grid.Row="2"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List item container: 56px row, Surface2 hover, 3px accent on select. -->
        <Style x:Key="DeviceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="56">
                            <!-- Hover/selected background -->
                            <Border x:Name="RowBg"
                                    Background="Transparent"/>
                            <!-- 3px left accent (selected only) -->
                            <Border x:Name="SelectAccent"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BrandPurpleBase}"
                                    Opacity="0"/>
                            <!-- Content indented past accent -->
                            <ContentPresenter Margin="20,0,16,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background"
                                        Value="{StaticResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background"
                                        Value="{StaticResource Surface2}"/>
                                <Setter TargetName="SelectAccent" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Device list box (shared by WASAPI / MME tabs) -->
        <Style x:Key="DeviceListBoxStyle" TargetType="ListBox">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DeviceListItemStyle}"/>
            <!-- Prevent WPF auto-selecting the first row when SelectedItem is set
                 to null (e.g. Reset with no original device). Without this the
                 CollectionView CurrentItem wiring immediately re-selects row 0. -->
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
        </Style>

        <!-- Device row template (Name + Detail + optional Default pill) -->
        <DataTemplate x:Key="DeviceRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource BodyStrongTextStyle}"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <!-- "Default" pill: shown when IsDefault = true -->
                <Border Grid.Column="1"
                        Padding="8,3" CornerRadius="4"
                        Background="{StaticResource BrandPurpleBase}"
                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis},
                                             FallbackValue=Collapsed}">
                    <TextBlock Text="Default"
                               Style="{StaticResource TinyTextStyle}"
                               Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Empty-state panel for deferred tabs -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="48">
                <Path Data="{StaticResource IconSpeaker}"
                      Fill="{StaticResource BrandPurpleGlow}"
                      Opacity="0.3"
                      Width="40" Height="40"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16"/>
                <TextBlock Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextTertiary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- ====================================================
         Main layout: header / stereo-mix banner / tabs / toast / footer
         ==================================================== -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (80px) -->
            <RowDefinition Height="80"/>
            <!-- Stereo Mix banner (Auto, hidden by default) -->
            <RowDefinition Height="Auto"/>
            <!-- Tab bar + content -->
            <RowDefinition Height="*"/>
            <!-- Auto-persist toast (Auto, hidden by default) -->
            <RowDefinition Height="Auto"/>
            <!-- Footer (64px) -->
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- === HEADER === -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Audio Source"
                           Style="{StaticResource DisplayTextStyle}"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Choose where Master's FM listens for now playing."
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- === STEREO MIX BANNER === -->
        <Border Grid.Row="1"
                Margin="24,8,24,0"
                Padding="16,12"
                CornerRadius="8"
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StereoMixDevicePresent}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StereoMixEnabled}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Stereo Mix is disabled"
                               Style="{StaticResource BodyStrongTextStyle}"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Margin="0,2,0,0"
                               Text="Enable Stereo Mix in Windows Sound to capture system audio for the spectrum."
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Open Windows Sound"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="16,0,0,0"
                        Command="{Binding OpenWindowsSoundCommand}"/>
            </Grid>
        </Border>

        <!-- === TAB BAR + CONTENT === -->
        <TabControl Grid.Row="2"
                    Margin="0,0,0,0"
                    Style="{StaticResource AudioTabControlStyle}">

            <!-- Tab header area: custom padding to align with header -->
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource AudioTabItemStyle}"/>
            </TabControl.Resources>

            <!-- WASAPI tab (output devices via WinRT enumeration) -->
            <TabItem Header="WASAPI">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <ListBox ItemsSource="{Binding OutputDevices}"
                             SelectedItem="{Binding SelectedWasapiDevice, Mode=TwoWay}"
                             Style="{StaticResource DeviceListBoxStyle}"
                             ItemTemplate="{StaticResource DeviceRowTemplate}"/>
                </ScrollViewer>
            </TabItem>

            <!-- MME tab -->
            <TabItem Header="MME"
                     Visibility="{Binding HasMme, Converter={StaticResource BoolToVis},
                                          FallbackValue=Visible}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding MmeDevices}"
                             SelectedItem="{Binding SelectedMmeDevice, Mode=TwoWay}"
                             Style="{StaticResource DeviceListBoxStyle}"
                             ItemTemplate="{StaticResource DeviceRowTemplate}"/>
                </ScrollViewer>
            </TabItem>

            <!-- KS tab: deferred / empty state -->
            <TabItem Header="KS">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="48">
                    <Path Data="{StaticResource IconSpeaker}"
                          Fill="{StaticResource BrandPurpleGlow}"
                          Opacity="0.3"
                          Width="40" Height="40"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16"/>
                    <TextBlock Text="Kernel Streaming devices appear here when available."
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextTertiary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- ASIO tab: static informational content.
                 Stage 7.12 Issue 4: always visible (HasAsio was always false since
                 no ASIO enumeration exists; tab shows informational message). -->
            <TabItem Header="ASIO"
                     Visibility="Visible">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="48">
                    <Path Data="{StaticResource IconSpeaker}"
                          Fill="{StaticResource BrandPurpleGlow}"
                          Opacity="0.3"
                          Width="40" Height="40"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360">
                        ASIO devices are configured directly in your DAW.
                        Master's FM doesn't need a separate ASIO selection.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- === AUTO-PERSIST TOAST (shown briefly after row click) === -->
        <!-- Driven by code-behind ShowToast() method; Opacity animated in/out -->
        <Border x:Name="ToastBanner"
                Grid.Row="3"
                Margin="24,4,24,4"
                Padding="16,8"
                CornerRadius="8"
                Background="{StaticResource BrandPurpleDeep}"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock Text="Audio source updated."
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- === FOOTER === -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Status from VM -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"/>
                <!-- Reset button (reverts to original-on-open selection) -->
                <Button Grid.Column="2"
                        Content="Reset"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnResetClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
