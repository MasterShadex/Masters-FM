<!-- Stage 7.7 Surface 09. 3-step wizard with internal navigation:
     Welcome -> Audio -> Platforms. Step indicator + Forward/Back/Skip
     buttons in footer. All colors via DynamicResource. -->
<Window x:Class="MastersFM.Tray.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MastersFM.Tray.ViewModels"
        Title="Master's FM setup"
        Width="780" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with step indicator -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="40" Height="40"
                   Source="pack://application:,,,/MastersFM_Tray_v14;component/assets/MastersFM.ico" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold"
                       Text="Master's FM setup"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Border Grid.Column="2" Padding="10,4" CornerRadius="4"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                <TextBlock Text="{Binding StepLabel}"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="White" />
            </Border>
        </Grid>

        <!-- Body: swap content based on CurrentStep -->
        <Border Grid.Row="1" Padding="16" CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <!-- Welcome step -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Welcome">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer DataContext="{Binding WelcomeVm}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Welcome to Master's FM"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Margin="0,8,0,16"
                                       Text="Master's FM listens to your music and shows it as an OBS overlay. Let's get you set up in three quick steps."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ListBox ItemsSource="{Binding PatchNotes}"
                                     MaxHeight="380"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingStackPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock>
                                                <Run Text="{Binding Version}" FontWeight="SemiBold" />
                                                <Run Text="  *  "
                                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Run Text="{Binding Date}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Audio step -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Audio">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel DataContext="{Binding AudioVm}">
                        <TextBlock Text="Pick an audio source"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="Master's FM samples this device for the live spectrum visuals."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ListBox ItemsSource="{Binding OutputDevices}"
                                 SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                 MaxHeight="320"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
                <!-- Platforms step -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="Platforms">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel DataContext="{Binding PlatformsVm}">
                        <TextBlock Text="Pick the platforms"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="All platforms are enabled by default. You can change these later from the tray menu."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ListBox ItemsSource="{Binding Platforms}"
                                 MaxHeight="380"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" MinHeight="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding HelperText}" FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Skip"
                    MinWidth="80"
                    Command="{Binding SkipCommand}" />
            <Button Grid.Column="2" Content="Back" MinWidth="80" Margin="8,0"
                    IsEnabled="{Binding CanGoBack}"
                    Command="{Binding BackCommand}" />
            <ui:Button Grid.Column="3"
                       Content="{Binding ForwardButtonLabel}"
                       MinWidth="120"
                       Appearance="Primary"
                       IsEnabled="{Binding CanGoForward}"
                       Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</Window>
