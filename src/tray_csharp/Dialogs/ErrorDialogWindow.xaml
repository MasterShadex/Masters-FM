<!-- Stage 7.7B-FIX STEP 4: ErrorDialogWindow visual rebuild.
     Replaces WPF-UI DynamicResource approach with AppDialogStyle + design tokens.
     Window: 480 wide, SizeToContent=Height, min 280, CenterScreen.
     AppDialogStyle provides custom chrome: 3px accent bar, title bar drag, close button.
     OnApplyTemplate in code-behind wires PART_TitleBar and PART_CloseButton.
     Layout: centered brand "i" icon, heading (Title binding), message body,
     optional technical-details collapse section, action buttons row. -->
<Window x:Class="MastersFM.Tray.Dialogs.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master's FM"
        Width="480"
        MinHeight="280"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppDialogStyle}">

    <!-- Content fills the ContentPresenter inside AppDialogStyle chrome.
         Outer padding: 24 sides, 16 top (accent bar + title bar give visual top space),
         24 bottom. -->
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <!-- Brand "i" icon -->
            <RowDefinition Height="Auto"/>
            <!-- Error heading -->
            <RowDefinition Height="Auto"/>
            <!-- Error message body -->
            <RowDefinition Height="Auto"/>
            <!-- Technical details toggle button -->
            <RowDefinition Height="Auto"/>
            <!-- Technical details panel (collapsed by default) -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- === Brand "i" icon (48x48, centered) === -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,8,0,16">
            <Path Data="{StaticResource IconInfo}"
                  Fill="{StaticResource BrandPurpleGlow}"
                  Width="48" Height="48"
                  Stretch="Uniform"/>
        </Border>

        <!-- === Error heading === -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Title}"
                   Style="{StaticResource HeadingTextStyle}"
                   Foreground="{StaticResource TextPrimary}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- === Error message body === -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Message}"
                   Style="{StaticResource BodyTextStyle}"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- === Technical-details toggle (only when HasTechnicalDetails) === -->
        <Button Grid.Row="3"
                Content="Show technical details"
                Style="{StaticResource TertiaryButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Visibility="{Binding HasTechnicalDetails,
                             Converter={StaticResource BoolToVis},
                             FallbackValue=Collapsed}"
                Command="{Binding ToggleTechnicalDetailsCommand}"/>

        <!-- === Technical-details panel (collapsed until toggled) === -->
        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="8"
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTechnicalDetails}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer MaxHeight="150"
                          VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         FontSize="11"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondary}"/>
            </ScrollViewer>
        </Border>

        <!-- === Action buttons row === -->
        <!-- Copy Details + View Log on left; OK primary on right. -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Copy details"
                    MinWidth="100"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding HasTechnicalDetails,
                                 Converter={StaticResource BoolToVis},
                                 FallbackValue=Collapsed}"
                    Command="{Binding CopyDetailsCommand}"/>

            <Button Grid.Column="1"
                    Content="View log"
                    MinWidth="90"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="8,0,0,0"
                    Command="{Binding OpenLogCommand}"/>

            <!-- OK: closes the dialog -->
            <Button Grid.Column="3"
                    Content="OK"
                    MinWidth="100"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
