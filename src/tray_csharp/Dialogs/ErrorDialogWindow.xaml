<!-- Stage 7.7 Surface 11. Error / crash dialog. Per Q-MOCK-11a default
     uses info icon + brand purple, NOT destructive red. All colors via
     DynamicResource. -->
<Window x:Class="MastersFM.Tray.Dialogs.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Master's FM"
        Width="540" Height="420"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                    VerticalAlignment="Top">
                <TextBlock Text="i"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White" />
            </Border>
            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                       Text="{Binding Title}"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Button Grid.Column="2" Content="X" Width="28" Height="28"
                    Background="Transparent"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="0"
                    Click="OnCloseButtonClick" />
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,4,0,12"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <Button Grid.Row="2" HorizontalAlignment="Left"
                Content="Show technical details"
                Background="Transparent"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                BorderThickness="0"
                Padding="0"
                Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Command="{Binding ToggleTechnicalDetailsCommand}" />

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="12" CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTechnicalDetails}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Copy details" MinWidth="120"
                    Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                    Command="{Binding CopyDetailsCommand}" />
            <Button Grid.Column="1" Content="Open log" MinWidth="100" Margin="8,0,0,0"
                    Command="{Binding OpenLogCommand}" />
            <ui:Button Grid.Column="3" Content="Close" MinWidth="100"
                       Appearance="Primary"
                       Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
