<!-- Stage 7.7 Surface 06. Platforms dialog. 8 toggles; per-platform
     auto-persist on change via VM PersistToggle path. All colors via
     DynamicResource. -->
<Window x:Class="MastersFM.Tray.Dialogs.PlatformsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Platform detection"
        Width="580" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- INTERRUPT #3 STEP 3 (Issue 5): drag on chrome-less window. -->
        <Grid Grid.Row="0" Margin="0,0,0,16"
              MouseLeftButtonDown="OnTitleBarDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Platform detection"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Pick which apps Master's FM listens to."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="X" Width="32" Height="32"
                    Background="Transparent"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="0"
                    Click="OnCloseButtonClick" />
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Platforms}"
                 Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,8" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding HelperText}" FontSize="11"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Toggles save automatically."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:Button Grid.Column="1" Content="Close" MinWidth="100"
                       Appearance="Primary"
                       Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
