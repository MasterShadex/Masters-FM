<!-- Stage 7.7B: STEP 3 WelcomeWindow first-run hero.
     Two-column layout: left brand/waveform (280px), right welcome content.
     Style=AppDialogStyle provides custom chrome (accent bar, title bar, shadow).
     Waveform bars are created in code-behind (OnLoaded) so we can phase-offset
     each bar's BeginTime without 32 redundant XAML elements.
     Trust signals: wordmark prominent, real version, specific feature copy,
     recognisable platform icons, no urgency, two clear reversible actions. -->
<Window x:Class="MastersFM.Tray.Dialogs.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master's FM"
        Width="1100" Height="780"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppDialogStyle}">

    <!-- Two-column content (fills ContentPresenter inside AppDialogStyle chrome) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: brand + waveform panel (fixed 280px; collapsed to 0 in
                 patch-notes mode so the version list gets the full width). -->
            <ColumnDefinition x:Name="LeftBrandColumn" Width="280"/>
            <!-- Right: welcome copy + actions (takes remaining width) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             LEFT COLUMN: Brand area
             Surface0 background (deeper than the chrome Surface1) creates
             a subtle two-tone split that visually separates hero from copy.
             ============================================================ -->
        <Border x:Name="LeftBrandPanel"
                Grid.Column="0"
                Background="{StaticResource Surface0}"
                CornerRadius="0,0,0,12"
                ClipToBounds="True">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="24,0">

                <!-- Wordmark -->
                <TextBlock Text="Master's FM"
                           Style="{StaticResource DisplayTextStyle}"
                           Foreground="{StaticResource BrandPurpleBase}"
                           TextAlignment="Center"/>

                <!-- Waveform visualization (bars added in code-behind OnLoaded).
                     VerticalAlignment=Bottom so bars grow upward from the baseline. -->
                <Canvas x:Name="WaveformCanvas"
                        Width="232" Height="56"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>

                <!-- Version string -->
                <TextBlock x:Name="VersionText"
                           Text="v14.0.0"
                           Style="{StaticResource TinyTextStyle}"
                           Foreground="{StaticResource TextTertiary}"
                           TextAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================================================
             RIGHT COLUMN: Welcome copy + actions
             ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Scrollable content area (in case window is smaller than expected) -->
            <ScrollViewer x:Name="WelcomeContentScroller"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="40,32,40,0">
                <StackPanel>

                    <!-- "WELCOME TO" overline -->
                    <TextBlock Text="WELCOME TO"
                               Style="{StaticResource TinyTextStyle}"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="0,0,0,8"/>

                    <!-- Display heading -->
                    <TextBlock Text="Master's FM"
                               Style="{StaticResource DisplayTextStyle}"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>

                    <!-- Tagline / body -->
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24">
                        Now Playing for streamers. Detect what you're listening to,
                        show it on your stream — or just enjoy it.
                    </TextBlock>

                    <!-- Feature bullets -->
                    <!-- Bullet: Spotify / SoundCloud / YouTube Music -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource IconSpeaker}"
                              Fill="{StaticResource BrandPurpleBase}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="Connects to Spotify, SoundCloud, YouTube Music, and more"/>
                    </Grid>

                    <!-- Bullet: OBS overlay -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource IconCamera}"
                              Fill="{StaticResource BrandPurpleBase}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="Adds a Now Playing overlay to OBS automatically"/>
                    </Grid>

                    <!-- Bullet: Customise -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource IconSparkle}"
                              Fill="{StaticResource BrandPurpleBase}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="Customise colors, layout, and animation"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Action buttons (pinned to bottom of right column) -->
            <Border x:Name="WelcomeActionButtons"
                    Grid.Row="1"
                    Padding="40,16,40,24">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Skip Setup"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnSkipSetup"/>
                    <Button Content="Get Started"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnGetStarted"/>
                </StackPanel>
            </Border>

            <!-- Stage 7.12: Patch Notes panel: shown instead of welcome copy when ShowAboutTab=true.
                 Code-behind (OnLoaded) collapses WelcomeContentScroller + WelcomeActionButtons
                 and shows this panel when WelcomeViewModel.ShowAboutTab is true.
                 Bound to WelcomeViewModel.PatchNotes (ObservableCollection loaded from
                 embedded patch_notes.json, 292 versions). -->
            <Grid x:Name="PatchNotesPanel"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="40,32,40,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header area (the small "Patch notes" overline was removed; the
                     window title bar already reads "You are currently running
                     version v...", so the redundant overline is gone). -->
                <TextBlock Grid.Row="0"
                           Text="Master's FM - Patch notes"
                           Style="{StaticResource DisplayTextStyle}"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,24"/>

                <!-- Version list -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding PatchNotes}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Version + date header -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Version}"
                                               Style="{StaticResource SubHeadingTextStyle}"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Date}"
                                               Style="{StaticResource TinyTextStyle}"
                                               Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Individual notes — coloured badge per tag type
                                     (NEW=green, IMPROVED=blue, FIXED=orange,
                                     REMOVED=red, NOTE/KEPT/PRESERVED=neutral). -->
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Tag badge -->
                                                <Border Grid.Column="0"
                                                        CornerRadius="4"
                                                        Padding="8,2"
                                                        Margin="0,2,12,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource TagNoteBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag}" Value="NEW">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource TagNewBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="ADDED">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource TagNewBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="IMPROVED">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource TagImprovedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="FIXED">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource TagFixedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="REMOVED">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource TagRemovedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Tag}"
                                                               Style="{StaticResource TinyTextStyle}"
                                                               Foreground="#FFFFFF"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Cluster B: post-update welcome panel. Shown instead of the
                 first-run welcome copy when WelcomeViewModel.JustUpdated is true.
                 Code-behind (OnLoaded) collapses WelcomeContentScroller +
                 WelcomeActionButtons (and other panels) and reveals this one.
                 Occupies the same area as the main welcome content. -->
            <Grid x:Name="JustUpdatedPanel"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="40,32,40,24">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Headline (brand display style; set in code-behind) -->
                    <TextBlock x:Name="JustUpdatedHeadline"
                               Text="Master's FM got updated"
                               Style="{StaticResource DisplayTextStyle}"
                               Foreground="{StaticResource TextPrimary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <!-- Optional version subline -->
                    <TextBlock x:Name="JustUpdatedSubline"
                               Text="You're on the latest build."
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,32"/>

                    <!-- Actions: primary opens customize overlay, secondary dismisses -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Awesome!"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="OnAwesome"/>
                        <Button Content="Open customize overlay"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenCustomize"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
