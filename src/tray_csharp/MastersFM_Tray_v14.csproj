<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stage 7.1B: WPF skeleton (replaces Stage 7.1 WinForms). Per
       V14_S7_REPLAN_WPF_LOCK.md locked stack:
         WPF + H.NotifyIcon.Wpf + WPF-UI + CommunityToolkit.Mvvm
         + Microsoft.Extensions.DependencyInjection
       Pinned NuGet versions documented in V14_S7_S7_1B_NUGET_PINS.md.
       PS tray (tray.ps1) ships unchanged through 7.1B; MSI cutover
       deferred to Stage 7.10. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Stage 7.8B STEP 9: needed for System.Windows.Forms.Screen (cursor-following dialogs) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MastersFM_Tray_v14</AssemblyName>
    <RootNamespace>MastersFM.Tray</RootNamespace>
    <ApplicationIcon>..\..\assets\MastersFM.ico</ApplicationIcon>
    <Version>14.0.0-rc.3</Version>
    <AssemblyVersion>14.0.0.0</AssemblyVersion>
    <FileVersion>14.0.0.0</FileVersion>
    <InformationalVersion>14.0.0-rc.3</InformationalVersion>
    <Company>MasterShadex</Company>
    <Product>Master's FM</Product>
    <Copyright>(c) MasterShadex</Copyright>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Locked NuGet stack: pinned versions per V14_S7_S7_1B_NUGET_PINS.md -->
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.15" />
  </ItemGroup>

  <!-- Implicit usings: WPF SDK does not include System.IO by default the way the
       WinForms SDK did; Logger.cs (preserved unchanged from Stage 7.1) relies on
       Path / Directory / File without explicit using. Add System.IO to the
       implicit using set so Logger.cs ports unmodified.
       Stage 7.8B STEP 9: UseWindowsForms=true (above) causes the SDK to inject a
       global 'using System.Windows.Forms' which makes 'Application' ambiguous
       vs System.Windows.Application throughout the WPF code-behind.  Remove the
       WinForms namespace from the implicit set; the two Screen/Cursor call sites
       in DialogService.cs already use the fully-qualified form. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Suppress WinForms-injected namespaces that collide with WPF equivalents. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Embed brand icon as a WPF Resource so MainWindow.xaml can reference it via
       pack URI ("pack://application:,,,/MastersFM_Tray_v14;component/...").
       H.NotifyIcon requires a BitmapFrame-compatible ImageSource (rejects
       InteropBitmap from CreateBitmapSourceFromHIcon), so the runtime
       Icon.ExtractAssociatedIcon -> InteropBitmap path does not work. -->
  <ItemGroup>
    <Resource Include="..\..\assets\MastersFM.ico">
      <Link>assets\MastersFM.ico</Link>
    </Resource>
  </ItemGroup>

  <!-- ProjectReference to tray_native.csproj (Stage 5.1 product). Provides
       MFM_Shell.SetCurrentProcessExplicitAppUserModelID for AUMID, plus
       MasterFM.AudioPeak and MasterFM.SMTC.SMTCWatcher for later sub-stages. -->
  <ItemGroup>
    <ProjectReference Include="..\tray_native\tray_native.csproj" />
  </ItemGroup>

  <!-- Stage 7.7: embed patch_notes.json (extracted from tray.ps1 PATCH_HISTORY
       at brief-start time). Loaded by WelcomeViewModel via
       Assembly.GetManifestResourceStream. ~332 KB; per brief STEP 3.3 explicit
       allowance. -->
  <ItemGroup>
    <EmbeddedResource Include="patch_notes.json" />
  </ItemGroup>

</Project>
