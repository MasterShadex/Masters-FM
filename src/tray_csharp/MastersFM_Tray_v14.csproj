<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Stage 7.1 skeleton: parallel sibling C# tray (Strategy C per V14_S7_P1_SLICING_ANALYSIS.md).
      Builds independently. MSI does NOT install this binary; ship deferred to Stage 7.10 cutover.
      Build flag in _full_rebuild.ps1: $UseDotnet8TrayCs (default $false). Opt-in via flag flip.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MastersFM_Tray_v14</AssemblyName>
    <RootNamespace>MastersFM.Tray</RootNamespace>
    <ApplicationIcon>..\..\assets\MastersFM.ico</ApplicationIcon>
    <Version>14.0.0-rc.1</Version>
    <AssemblyVersion>14.0.0.0</AssemblyVersion>
    <FileVersion>14.0.0.0</FileVersion>
    <InformationalVersion>14.0.0-rc.1+stage7.1.skeleton</InformationalVersion>
    <Company>MasterShadex</Company>
    <Product>Master's FM</Product>
    <Copyright>(c) MasterShadex</Copyright>
    <!-- Workstation GC for single-threaded UI process (per V14_S7_P1_RISKS.md R14). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      BaseIntermediateOutputPath inherited from src/Directory.Build.props
      (apphost cross-contamination protection; resolves to src/obj/MastersFM_Tray_v14/).
      RuntimeIdentifier / PublishSingleFile / PublishReadyToRun / Configuration are set
      on the dotnet publish command line in _full_rebuild.ps1 (matches launcher.csproj pattern).
    -->
  </PropertyGroup>

  <!--
    Reuse tray_native.dll: provides MFM_Shell (AUMID), MasterFM.AudioPeak,
    MasterFM.Win32Windows, MasterFM.SMTC.* (used in later sub-stages 7.5+).
    tray_native targets netstandard2.0 (Stage 5.1 decision); references cleanly
    from net8.0-windows since netstandard2.0 is a subset.
  -->
  <ItemGroup>
    <ProjectReference Include="..\tray_native\tray_native.csproj" />
  </ItemGroup>
</Project>
