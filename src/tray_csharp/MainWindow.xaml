<!-- Stage 7.1B: Hidden host window for the H.NotifyIcon.Wpf TaskbarIcon.
     Window is permanently invisible; it exists only so the dispatcher loop
     has something to manage. Tray icon is the user-facing surface. The
     TaskbarIcon's IconSource is set at runtime in MainWindow.xaml.cs to
     extract from the process's Win32 ApplicationIcon resource (matches
     Stage 7.1 approach via Icon.ExtractAssociatedIcon, adapted for WPF). -->
<Window x:Class="MastersFM.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="MastersFM Tray Host"
        Width="0"
        Height="0"
        Top="-1000"
        Left="-1000"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        WindowStartupLocation="Manual"
        Topmost="False"
        ResizeMode="NoResize">

    <tb:TaskbarIcon x:Name="NotifyIcon"
                    IconSource="pack://application:,,,/MastersFM_Tray_v14;component/assets/MastersFM.ico"
                    ToolTipText="Master's FM v14 dev (skeleton)"
                    NoLeftClickDelay="True">

        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Quit"
                          Click="OnQuitClicked" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>

</Window>
