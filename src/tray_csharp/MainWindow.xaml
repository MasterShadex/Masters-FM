<!-- Stage 7.6 STEP 7: Hidden host window + full Surface 03 tray ContextMenu.
     DataContext of ContextMenu is set to TrayMenuViewModel in OnLoaded (code-
     behind) because ContextMenu popup is not in the visual tree of MainWindow
     and cannot inherit DataContext automatically. Styling (TrayMenu* brushes,
     Mica backdrop) is applied in STEP 11. -->
<Window x:Class="MastersFM.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="MastersFM Tray Host"
        Width="0"
        Height="0"
        Top="-1000"
        Left="-1000"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        WindowStartupLocation="Manual"
        Topmost="False"
        ResizeMode="NoResize">

    <tb:TaskbarIcon x:Name="NotifyIcon"
                    IconSource="pack://application:,,,/MastersFM_Tray_v14;component/assets/MastersFM.ico"
                    ToolTipText="Master's FM v14"
                    NoLeftClickDelay="True">

        <tb:TaskbarIcon.ContextMenu>
            <!-- Background and Mica backdrop wired in STEP 11 (OnLoaded code-behind). -->
            <ContextMenu MinWidth="220">

                <!-- 1. Now-playing row: art + artist + track. IsEnabled=false so clicks
                        pass through; the row is display-only in 7.6. -->
                <MenuItem IsEnabled="False">
                    <MenuItem.Header>
                        <Grid MinWidth="200" Margin="0,2,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 24x24 album art thumbnail -->
                            <Image Grid.Column="0"
                                   Width="24" Height="24"
                                   Source="{Binding NowPlaying.ArtImageSource}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding NowPlaying.Artist,
                                                  TargetNullValue='Not playing',
                                                  FallbackValue='Not playing'}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding NowPlaying.Track,
                                                  TargetNullValue='',
                                                  FallbackValue=''}"
                                           FontSize="10"
                                           Opacity="0.65"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>

                <Separator />

                <!-- 2. Platform detection -->
                <MenuItem Header="Platform detection"
                          Command="{Binding OpenPlatformDetectionCommand}" />

                <!-- 3. Audio source -->
                <MenuItem Header="Audio source"
                          Command="{Binding OpenAudioSourceCommand}" />

                <!-- 4. Customize overlay -->
                <MenuItem Header="Customize overlay"
                          Command="{Binding OpenCustomizerCommand}" />

                <!-- 5. Discord [toggle] -->
                <MenuItem Header="Discord"
                          IsCheckable="True"
                          IsChecked="{Binding IsDiscordEnabled, Mode=OneWay}"
                          Command="{Binding ToggleDiscordCommand}" />

                <!-- 6. Start on login [toggle] -->
                <MenuItem Header="Start on login"
                          IsCheckable="True"
                          IsChecked="{Binding IsAutoStartEnabled, Mode=OneWay}"
                          Command="{Binding ToggleAutoStartCommand}" />

                <!-- 7. OBS placeholder — deferred to 7.8; IsEnabled=false -->
                <MenuItem Header="OBS overlay"
                          IsEnabled="False" />

                <Separator />

                <!-- 8. Patch notes -->
                <MenuItem Header="Patch notes"
                          Command="{Binding OpenPatchNotesCommand}" />

                <!-- 9. View log -->
                <MenuItem Header="View log"
                          Command="{Binding OpenLogCommand}" />

                <!-- 10. Check for updates — label is state-driven via TrayMenuViewModel.UpdateLabel -->
                <MenuItem Header="{Binding UpdateLabel}"
                          Command="{Binding CheckUpdatesCommand}" />

                <!-- 11. Restart -->
                <MenuItem Header="Restart Master's FM"
                          Command="{Binding RestartAppCommand}" />

                <!-- 12. Quit -->
                <MenuItem Header="Quit Master's FM"
                          Command="{Binding QuitAppCommand}" />

            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>

</Window>
