<!-- Stage 7.7B STEP 5: Hidden host window + styled tray ContextMenu.
     AppContextMenuStyle applies rounded-12 shell + CardHoverShadow.
     AppMenuItemStyle applies 36px rows with 3-column icon/label/check layout.
     AppMenuSeparatorStyle applies 1px BorderSubtle divider lines.
     Header item: "Master's FM" wordmark + NowPlayingHeaderText subtitle.
     DataContext of ContextMenu is set to TrayMenuViewModel in OnLoaded (code-
     behind) because ContextMenu popup is not in the visual tree of MainWindow
     and cannot inherit DataContext automatically. -->
<Window x:Class="MastersFM.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="MastersFM Tray Host"
        Width="0"
        Height="0"
        Top="-1000"
        Left="-1000"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        WindowStartupLocation="Manual"
        Topmost="False"
        ResizeMode="NoResize">

    <!-- INTERRUPT #3 STEP 2 (Issue 7): LeftClickCommand fires ShowMenuCommand
         which opens the ContextMenu at the cursor position. NoLeftClickDelay
         suppresses the 500ms OS deferral so the menu appears immediately.
         DataContext = TrayMenuViewModel is set in code-behind constructor. -->
    <tb:TaskbarIcon x:Name="NotifyIcon"
                    IconSource="pack://application:,,,/MastersFM_Tray_v14;component/assets/MastersFM.ico"
                    ToolTipText="Master's FM v14"
                    LeftClickCommand="{Binding ShowMenuCommand}"
                    NoLeftClickDelay="True">

        <tb:TaskbarIcon.ContextMenu>
            <!-- AppContextMenuStyle: Surface1 bg, 12px radius, CardHoverShadow.
                 On Win11 22H2+ the code-behind overrides Background=Transparent
                 and applies Acrylic so the system backdrop shows through the
                 rounded border shape. Branch B (Win10) uses Surface1 directly. -->
            <ContextMenu Style="{StaticResource AppContextMenuStyle}">

                <!-- === Header: wordmark + now-playing status ===
                     IsEnabled=False prevents keyboard selection and click.
                     Opacity trigger in AppMenuItemStyle renders at 45%; override
                     to 1.0 so the header is always full-opacity.
                     Stage 7.12 Batch A: negative left margin pulls the
                     header text out of the label column so it spans the full
                     menu width — without the indent it visually anchors the
                     top of the menu instead of looking like an icon-less item. -->
                <MenuItem IsEnabled="False"
                          Style="{StaticResource AppMenuHeaderStyle}"
                          Opacity="1">
                    <MenuItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Album art (44x44 rounded square, collapses when
                                 no track is currently playing). -->
                            <Border Grid.Column="0"
                                    Width="44" Height="44"
                                    Margin="0,0,10,0"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Surface2}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NowPlaying.ArtImageSource}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding NowPlaying.ArtImageSource}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Master's FM"
                                           FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandPurpleBase}"/>
                                <!-- Marquee viewport: FIXED 220-px-wide clipped Grid so a
                                     long track title can't stretch the whole context menu
                                     (operator screenshot of "Good Morning Charlie ..." had
                                     the menu blow out 600+ px wide).  The TextBlock is
                                     wrapped in a Canvas so WPF passes Infinity as its
                                     measure constraint — TextBlock.ActualWidth therefore
                                     equals the FULL text width (not the clipped 220 px),
                                     which is what the marquee animation needs to know how
                                     far to scroll leftward each loop. -->
                                <Grid x:Name="NowPlayingMarqueeViewport"
                                      Width="220"
                                      Height="16"
                                      ClipToBounds="True"
                                      HorizontalAlignment="Left"
                                      Margin="0,3,0,0">
                                    <Canvas>
                                        <TextBlock x:Name="NowPlayingMarquee"
                                                   Text="{Binding NowPlayingHeaderText}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="NoWrap"
                                                   Loaded="OnNowPlayingMarqueeLoaded"
                                                   SizeChanged="OnNowPlayingMarqueeSizeChanged">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="NowPlayingMarqueeTransform"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>

                <Separator Style="{StaticResource AppMenuSeparatorStyle}"/>

                <!-- 2. Platform detection -->
                <MenuItem Header="Platform detection"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding OpenPlatformDetectionCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSettings}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 3. Audio source -->
                <MenuItem Header="Audio source"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding OpenAudioSourceCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSpeaker}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 4. Customize overlay -->
                <MenuItem Header="Customize overlay"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding OpenCustomizerCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSparkle}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 5. Discord [toggle] -->
                <MenuItem Header="Discord"
                          Style="{StaticResource AppMenuItemStyle}"
                          IsCheckable="True"
                          IsChecked="{Binding IsDiscordEnabled, Mode=OneWay}"
                          Command="{Binding ToggleDiscordCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconDiscord}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 6. Start on login [toggle] -->
                <MenuItem Header="Start on login"
                          Style="{StaticResource AppMenuItemStyle}"
                          IsCheckable="True"
                          IsChecked="{Binding IsAutoStartEnabled, Mode=OneWay}"
                          Command="{Binding ToggleAutoStartCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconStartup}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 7. OBS overlay [toggle]; label + tooltip are state-driven -->
                <MenuItem Header="{Binding ObsLabel}"
                          Style="{StaticResource AppMenuItemStyle}"
                          IsCheckable="True"
                          IsChecked="{Binding IsObsEnabled, Mode=OneWay}"
                          Command="{Binding ToggleObsCommand}"
                          ToolTip="{Binding ObsTooltip}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconCamera}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator Style="{StaticResource AppMenuSeparatorStyle}"/>

                <!-- 8. Patch notes -->
                <MenuItem Header="Patch notes"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding OpenPatchNotesCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconInfo}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 9. View log -->
                <MenuItem Header="View log"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding OpenLogCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconDocument}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 10. Check for updates; label is state-driven via UpdateLabel -->
                <MenuItem Header="{Binding UpdateLabel}"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding CheckUpdatesCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconReset}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 11. Restart -->
                <MenuItem Header="Restart Master's FM"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding RestartAppCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconRestart}"
                              Fill="{StaticResource TextSecondary}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- 12. Quit -->
                <MenuItem Header="Quit Master's FM"
                          Style="{StaticResource AppMenuItemStyle}"
                          Command="{Binding QuitAppCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconClose}"
                              Fill="{StaticResource TextSecondary}"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>

            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>

</Window>
