<!-- Stage 7.7B-FIX STEP 4: UpdateProgressWindow visual rebuild.
     Replaces WPF-UI DynamicResource approach with AppDialogStyle + design tokens.
     Window: 480 wide, SizeToContent=Height, CenterScreen.
     AppDialogStyle provides 3px accent bar, title bar drag, close button.
     OnApplyTemplate in code-behind wires PART_TitleBar and PART_CloseButton.
     Content is state-driven: DataTriggers on CurrentState control section visibility.
     States: Idle, Checking, Available, Downloading, Ready, Installing, Error.
     ViewModel: UpdateCheckViewModel (UpdateState CurrentState, StatusText,
                ProgressPercent, AvailableVersion, LastCheckedDisplay, ErrorMessage,
                IsProgressIndeterminate, AuthenticodeBadgeVisibility,
                IsCheckNowEnabled, IsDownloadEnabled, IsInstallEnabled, IsCancelEnabled,
                CheckNowCommand, DownloadCommand, InstallCommand, CancelCommand). -->
<Window x:Class="MastersFM.Tray.Update.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:update="clr-namespace:MastersFM.Tray.Update"
        Title="Master's FM"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppDialogStyle}">

    <!-- Content fills the ContentPresenter inside AppDialogStyle chrome. -->
    <StackPanel Margin="24,16,24,24">

        <!-- === State icon: shown for non-progress states === -->
        <!-- Check icon: Idle (up to date) or Ready states -->
        <Border HorizontalAlignment="Center" Margin="0,8,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Idle}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Ready}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Path Data="{StaticResource IconCheck}"
                  Fill="{StaticResource BrandPurpleBase}"
                  Width="40" Height="40"
                  Stretch="Uniform"/>
        </Border>

        <!-- Error icon: shown for Error state only -->
        <Border HorizontalAlignment="Center" Margin="0,8,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Error}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Path Data="{StaticResource IconInfo}"
                  Fill="{StaticResource BrandPurpleGlow}"
                  Width="40" Height="40"
                  Stretch="Uniform"/>
        </Border>

        <!-- === Heading: StatusText (always shown) === -->
        <TextBlock Text="{Binding StatusText}"
                   Style="{StaticResource HeadingTextStyle}"
                   Foreground="{StaticResource TextPrimary}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- === Progress section: Checking / Downloading / Installing === -->
        <!-- Indeterminate bar: Checking and Installing states -->
        <ProgressBar Height="4"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="True"
                     Foreground="{StaticResource BrandPurpleBase}"
                     Background="{StaticResource Surface2}"
                     Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Checking}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Installing}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Determinate bar + percent caption: Downloading state -->
        <StackPanel Margin="0,0,0,8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Downloading}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ProgressBar Height="4"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent}"
                         IsIndeterminate="False"
                         Foreground="{StaticResource BrandPurpleBase}"
                         Background="{StaticResource Surface2}"
                         Margin="0,0,0,8"/>
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource TextSecondary}"
                       TextAlignment="Center">
                <Run Text="{Binding ProgressPercent}"/>
                <Run Text="% complete"/>
            </TextBlock>
        </StackPanel>

        <!-- === Last-checked info: Idle / Available states === -->
        <TextBlock Foreground="{StaticResource TextSecondary}"
                   TextAlignment="Center"
                   Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Idle}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Available}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="Last checked: "/>
            <Run Text="{Binding LastCheckedDisplay}"/>
        </TextBlock>

        <!-- === Error detail message: Error state === -->
        <TextBlock Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Text="{Binding ErrorMessage}"
                   Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentState}"
                                     Value="{x:Static update:UpdateState.Error}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- === Authenticode badge: Ready state only === -->
        <Border Padding="12,8"
                CornerRadius="8"
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource BrandPurpleBase}"
                BorderThickness="1"
                Margin="0,0,0,16"
                Visibility="{Binding AuthenticodeBadgeVisibility}">
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       TextAlignment="Center">
                <Run Text="Authenticode verified"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}"/>
                <Run Text="   CN=MasterShadex"
                     Foreground="{StaticResource TextSecondary}"/>
            </TextBlock>
        </Border>

        <!-- === Action buttons === -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0">

            <!-- Check Now: Idle and Error states -->
            <Button Content="Check Now"
                    MinWidth="100"
                    IsEnabled="{Binding IsCheckNowEnabled}"
                    Command="{Binding CheckNowCommand}"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Idle}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Error}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Download: Available state -->
            <Button Content="Download"
                    MinWidth="100"
                    IsEnabled="{Binding IsDownloadEnabled}"
                    Command="{Binding DownloadCommand}"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Available}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Install: Ready state -->
            <Button Content="Install now"
                    MinWidth="100"
                    IsEnabled="{Binding IsInstallEnabled}"
                    Command="{Binding InstallCommand}"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Ready}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Cancel: Checking / Downloading states -->
            <Button Content="Cancel"
                    MinWidth="100"
                    IsEnabled="{Binding IsCancelEnabled}"
                    Command="{Binding CancelCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Checking}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Downloading}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Close: Idle / Ready / Error / Installing states -->
            <Button Content="Close"
                    MinWidth="100"
                    Click="OnCloseClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Idle}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Ready}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Error}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentState}"
                                         Value="{x:Static update:UpdateState.Installing}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>

    </StackPanel>
</Window>
